# Copy this file to DEPLOY_DIR/.env, edit it, and chmod 0600.
# Never commit the resulting .env file.

KIMI_IMAGE=voipmonitor/vllm:infernal-invocation-vllm7ed814e-b12x5d648d9-fi1ac6942-cu133-torch213-20260813-r7

# Host directories. Replace every example path.
MODEL_PATH=/srv/models/Kimi-K3-QSRT-K2
KIMI_CACHE_PATH=/srv/kimi-k3/cache
KIMI_TMP_PATH=/srv/kimi-k3/tmp
LMCACHE_L2_PATH=/srv/lmcache/kimi-k3/l2
LMCACHE_TMP_PATH=/srv/lmcache/kimi-k3/tmp

# Optional. Leave empty if all model/tokenizer files are local and accessible.
HF_TOKEN=

# Tested serving profile. Values can be overridden here, but changing them
# requires a new capacity and cache-alignment validation.
K3_SERVED_MODEL_NAME=Kimi-K3
K3_MAX_MODEL_LEN=420000
K3_GPU_MEMORY_UTILIZATION=0.9765
K3_KV_CACHE_MEMORY_BYTES=2147483648
K3_MAX_NUM_BATCHED_TOKENS=1536
K3_MAX_NUM_SEQS=2
K3_LMCACHE_CHUNK_SIZE=12288
K3_LMCACHE_L1_GB=48
K3_LMCACHE_L1_INIT_GB=48
K3_LMCACHE_L2_GB=1200
K3_LMCACHE_TRANSFER_MODE=engine_driven
